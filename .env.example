# ============================================================
#  ITSJO – Variables de entorno
#  Renombra este archivo a exactamente:  .env
#  NUNCA subas este archivo a GitHub ni lo compartas
# ============================================================

# ── Puerto del servidor (puedes dejarlo en 3000) ──────────
PORT=3000

# ── Tu cuenta de Gmail ────────────────────────────────────
# Pon aquí tu correo de Gmail completo
GMAIL_USER=tucorreo@gmail.com

# Pon aquí la CONTRASEÑA DE APLICACIÓN (no tu contraseña normal)
# Cómo obtenerla:
#   1. Ve a myaccount.google.com
#   2. Seguridad → Verificación en 2 pasos (actívala si no está)
#   3. Busca "Contraseñas de aplicaciones"
#   4. Crea una nueva → elige "Otra (nombre personalizado)" → ponle "ITSJO"
#   5. Copia las 16 letras que te da y pégalas aquí (sin espacios)
GMAIL_PASS=abcdabcdabcdabcd

# ── Correo donde llegarán las pre-inscripciones ───────────
# Puede ser el mismo GMAIL_USER u otro correo diferente
CORREO_DESTINO=correo_instituto@gmail.com
